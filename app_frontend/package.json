    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.7.4",
    "react-router": "^7.13.0",
    "recharts": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.6"
