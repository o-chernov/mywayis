# Скопируйте в .env и заполните. Файл .env в git не попадает.

# — Django —
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# — Соседние сервисы —
# API — владелец данных о пользователях, туда уходит регистрация.
API_BASE_URL=http://127.0.0.1:8001
# Личный кабинет: туда ведёт кнопка после успешной регистрации.
APP_URL=http://localhost:5173
# Собственный адрес — для canonical, sitemap и Open Graph.
SITE_URL=http://127.0.0.1:8000

# — Регистрация —
# stub — форма работает на заглушке (пока эндпоинта в API нет).
# http — реальный POST на {API_BASE_URL}/auth/register.
# В продакшене допустимо только http, иначе приложение не стартует.
REGISTRATION_BACKEND=stub
REGISTRATION_TIMEOUT_SECONDS=5

# — Почта (уведомления с формы контактов) —
# В разработке письма печатаются в консоль.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_USE_TLS=True
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mywayis.com

# — Защита форм —
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW_SECONDS=600
FORM_MIN_FILL_SECONDS=3
# Соль для хеширования IP: адреса в открытом виде не храним.
IP_HASH_SALT=
