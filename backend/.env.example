# — Окружение —
# local | stage | production. В production не отдаются /docs и схема OpenAPI.
ENVIRONMENT=local

# — Администратор —
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_TOKEN=change-me

# — JWT —
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_LEEWAY_SECONDS=60
# Необязательные: если не заданы, iss и aud в токене не проверяются.
# JWT_ISSUER=
# JWT_AUDIENCE=

# — Refresh-кука —
# Пусто — кука привязана к текущему хосту. В продакшене: api.mywayis.com.
COOKIE_DOMAIN=
SECURE_COOKIES=True
# lax | strict | none
SAMESITE_COOKIES=lax
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth

# — Токены в письмах —
# Значения по умолчанию; раскомментируйте, чтобы изменить.
# EMAIL_TOKEN_TTL_MINUTES=1440
# EMAIL_RESET_TOKEN_EXPIRE_HOURS=1

# — PostgreSQL —
# Драйвер asyncpg нужен и приложению, и Alembic.
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://myway:change-me@localhost:5432/myway_db
ALEMBIC_SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://myway:change-me@localhost:5432/myway_db

# — RabbitMQ (брокер Celery) —
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# — Почта —
SMTP_USE_TLS=True
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mywayis.com

# — Адреса и CORS —
# Список источников — в формате JSON.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
API_BASE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:5173
